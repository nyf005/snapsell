# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma (Neon/Postgres)
# https://www.prisma.io/docs/reference/database-reference/connection-urls
# Neon: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Local: postgresql://postgres:password@localhost:5432/snapsell
DATABASE_URL="postgresql://postgres:password@localhost:5432/snapsell"

# NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# Live session auto close (Story 2.6) - fenêtre inactivité en minutes (MVP 30–60)
# Même valeur pour résolution « session courante » et job de fermeture
LIVE_SESSION_INACTIVITY_WINDOW_MINUTES="45"

# Reservation TTL (Story 4.3) - durée en minutes avant expiration (5–15), défaut 10
# RESERVATION_TTL_MINUTES="10"

# Story 4.5: TTL soft (sans acompte) vs locked (avec acompte) ; TTL preuve d'acompte
# RESERVATION_TTL_SOFT_MINUTES="5"
# RESERVATION_TTL_LOCKED_MINUTES="12"
# DEPOSIT_TTL_MINUTES="15"

# Webhook rate limiting (par IP) – optionnel, défauts: 120 req / 60 s
# WEBHOOK_RATE_LIMIT_MAX=120
# WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# Sentry (optionnel) – si défini, erreurs critiques webhook remontées
# Créer sentry.server.config.ts + instrumentation.ts (voir DEPLOYMENT.md)
# SENTRY_DSN=""

# R2 (Cloudflare) – stockage des médias (Story 3.4, photo optionnelle)
# Optionnel : sans R2, le flux CODE xQTE fonctionne ; l’upload photo est ignoré.
# Créer un bucket R2 puis : R2 → Manage R2 API Tokens → Create API token (Object Read & Write).
# Endpoint : https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# IMPORTANT : requis sur Vercel ET Railway — le proxy /api/media/[...key] lit R2 depuis Vercel.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""

# Catalogue Meta – synchro vers Meta Commerce Manager (Starter/Pro)
# META_CATALOG_SYNC_ENABLED="true"
# Image placeholder pour articles sans photo (URL publique permanente, ex. CDN ou asset hébergé)
# Utilisée à la place de mediaStorageKey=null pour débloquer la sync Meta.
# CATALOGUE_PLACEHOLDER_IMAGE_URL=""

# Meta WhatsApp Cloud API (Story 10.1) – secret pour vérifier les signatures webhook Meta
# et token de vérification pour le challenge GET du webhook
# META_APP_ID=""
# META_APP_SECRET=""
# META_VERIFY_TOKEN=""
# Accès serveur uniquement à la saisie manuelle Phone Number ID / WABA ID / token.
# Le compte support doit aussi être membre de la boutique concernée.
# WHATSAPP_SUPPORT_EMAILS="support@snapsell.ci,admin@snapsell.ci"
# NEXT_PUBLIC_META_APP_ID=""
# NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=""
# NEXT_PUBLIC_META_EMBEDDED_SIGNUP_ENABLED="true"
# Parcours Coexistence : garde le numéro déjà utilisé dans l'application
# WhatsApp Business au lieu d'en faire déclarer un neuf.
#
# La reprise de l'historique est implémentée : demande lancée dans la fenêtre de
# 24 h, et traitement de `history`, `smb_app_state_sync` et `smb_message_echoes`.
#
# État SnapSell au 2026-08-13 : entreprise et Access Verification Tech Provider
# vérifiées, Advanced Access accordé sur whatsapp_business_management et
# whatsapp_business_messaging, application Meta publiée. La disponibilité finale
# reste validée par Meta pendant le parcours du numéro réel.
#
# Variable Vercel uniquement. Comme toute variable NEXT_PUBLIC_*, elle est figée
# au build : redéployer Vercel après l'avoir passée à "true". Le worker Railway
# doit néanmoins être déployé sur le même commit pour consommer coexistence-sync.
# NEXT_PUBLIC_META_COEXISTENCE_ENABLED="false"

# Chiffrement at-rest (Epic 13) – AES-256-GCM pour metaAccessToken en DB
# Générer : openssl rand -hex 32
# OBLIGATOIRE en production. En dev/test : omis = plaintext (dégradation gracieuse)
# ENCRYPTION_KEY=""

# Upstash QStash (Epic 13 – outbox serverless)
# Console : https://console.upstash.com → QStash → API Keys
# En dev sans ces vars : fallback pg-boss local
# QSTASH_TOKEN=""
# QSTASH_CURRENT_SIGNING_KEY=""
# QSTASH_NEXT_SIGNING_KEY=""

# Upstash Redis (Epic 13 – rate limiting tRPC, 20 req/min par userId)
# Console : https://console.upstash.com → Redis → REST API
# En dev sans ces vars : rate limiting désactivé
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Sécurité cron Vercel (Epic 13) – Bearer token injecté par Vercel sur les routes cron
# Générer : openssl rand -hex 16
# CRON_SECRET=""

# Paystack (Story 7A.2) – paiements & abonnements
# Dashboard: https://dashboard.paystack.com → API Keys (test: sk_test_..., pk_test_...)
# Plans: Products → Plans → créer Starter (25 000 XOF/mois) et Pro (50 000 XOF/mois) → copier plan_code
# Carte test: 4084 0840 8408 4081, exp 12/30, CVV 408
# PAYSTACK_SECRET_KEY=""
# PAYSTACK_PUBLIC_KEY=""
# PAYSTACK_PLAN_STARTER=""
# PAYSTACK_PLAN_PRO=""
# URL publique de l'app (callbacks Paystack, liens). En prod Vercel : https://snapsell-nine.vercel.app
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="https://snapsell-nine.vercel.app"

# ------------------------------------------------------------------------------
# Déploiement : où mettre chaque variable ?
# Vercel = app Next.js (web + webhook + crons + QStash callbacks)
# Railway = worker pg-boss (webhook-processor uniquement)
# ------------------------------------------------------------------------------
# VERCEL                               | RAILWAY (worker pg-boss)
# -------------------------------------|-----------------------------------------
# DATABASE_URL (Neon pooler)      ✓    | DATABASE_URL (Neon non-pooler)     ✓
# AUTH_SECRET                     ✓    | —
# NEXT_PUBLIC_APP_URL             ✓    | NEXT_PUBLIC_APP_URL                ✓
# META_APP_ID                     ✓    | META_APP_ID                        ✓
# META_APP_SECRET                 ✓    | META_APP_SECRET                    ✓
# META_VERIFY_TOKEN               ✓    | —
# NEXT_PUBLIC_META_APP_ID         ✓    | —
# ENCRYPTION_KEY (requis prod)    ✓    | ENCRYPTION_KEY (même valeur)       ✓
# QSTASH_TOKEN                    ✓    | QSTASH_TOKEN                       ✓
# QSTASH_CURRENT_SIGNING_KEY      ✓    | —
# QSTASH_NEXT_SIGNING_KEY         ✓    | —
# UPSTASH_REDIS_REST_URL          ✓    | —
# UPSTASH_REDIS_REST_TOKEN        ✓    | —
# CRON_SECRET                     ✓    | —
# R2_* (4 variables)              ✓    | R2_* (4 variables)                 ✓
# META_CATALOG_SYNC_ENABLED       ✓    | META_CATALOG_SYNC_ENABLED          ✓
# CATALOGUE_PLACEHOLDER_IMAGE_URL ✓    | —
# PAYSTACK_*                      ✓    | —
# SENTRY_DSN (opt)                ✓    | SENTRY_DSN (opt)                   ✓
# LIVE_SESSION_INACTIVITY_...     —    | LIVE_SESSION_INACTIVITY_...        ✓
# RESERVATION_TTL_* (opt)         —    | RESERVATION_TTL_* (opt)            ✓
