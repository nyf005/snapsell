// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Roles for RBAC (Owner = vendeur créateur du tenant, OPS = accès console ops sans tenant)
//
// VENDEUR a été retiré : aucun contrôle de permission ne le distinguait d'AGENT.
// Tous testent canManageGrid, isOpsUser, ou si la cible est OWNER — deux étiquettes
// pour un seul accès réel. Voir ASSIGNABLE_ROLES dans src/lib/rbac.ts.
enum Role {
  OWNER
  MANAGER
  AGENT
  OPS
}

model Tenant {
  id                    String    @id @default(cuid())
  name                  String
  // Meta WhatsApp Cloud API (Story 10.1)
  metaPhoneNumberId     String?   @unique @map("meta_phone_number_id")
  metaWabaId            String?   @map("meta_waba_id")
  metaAccessToken       String?   @map("meta_access_token") // Chiffré AES-256-GCM via src/lib/crypto.ts
  requireDeposit        Boolean   @default(false) @map("require_deposit") // Story 4.5: acompte activé → TTL locked, demande preuve
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  // Subscription (Story 7A.2)
  subscriptionPlan      String    @default("free") @map("subscription_plan")
  // "free" | "starter" | "pro"
  subscriptionStatus    String    @default("active") @map("subscription_status")
  // "active" | "attention" | "non_renewing" | "expired" | "cancelled"
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  // null = Free (pas d'expiration) ; set à +30j après paiement pour Starter/Pro
  cycleStartedAt        DateTime? @map("cycle_started_at")
  // Début du cycle courant (pour compter l'usage). null = Free

  // Credits système (Story Credits)
  creditsBalance      Int       @default(70) @map("credits_balance")
  // Credits disponibles. Default 70 pour Free (plan gratuit).
  creditsTotalMonthly Int       @default(70) @map("credits_total_monthly")
  // Credits inclus par mois selon le plan.
  creditsBonus        Int       @default(0) @map("credits_bonus")
  // Credits achetés (packs) — ne se remettent pas à zéro au reset mensuel.
  usageResetDate      DateTime? @map("usage_reset_date")
  // Date de reset mensuel des credits.
  lowCreditsAlerted   Boolean   @default(false) @map("low_credits_alerted")
  // Flag pour éviter les alertes multiples.

  // Paystack references
  paystackCustomerCode      String? @unique @map("paystack_customer_code")
  paystackSubscriptionCode  String? @unique @map("paystack_subscription_code")
  paystackEmailToken        String? @map("paystack_email_token")
  paystackAuthorizationCode String? @map("paystack_authorization_code")

  // Entitlements — quotas numériques
  maxConfirmedOrdersPerMonth Int @default(50) @map("max_confirmed_orders_per_month")
  maxProofsPerMonth          Int @default(20) @map("max_proofs_per_month") // -1 = illimité
  maxAgents                  Int @default(0) @map("max_agents") // 0 = pas d'agents
  overagePerOrderCents       Int @default(0) @map("overage_per_order_cents") // 0 = blocage (Free)

  // Entitlements — feature flags
  hasAI                      Boolean @default(false) @map("has_ai")
  hasExportCsv               Boolean @default(false) @map("has_export_csv")
  hasAdvancedExports         Boolean @default(false) @map("has_advanced_exports")
  hasNotificationsOutside24h Boolean @default(false) @map("has_notifications_outside_24h")
  hasDepositRecommended      Boolean @default(false) @map("has_deposit_recommended")
  hasAdvancedFilters         Boolean @default(false) @map("has_advanced_filters")
  hasPrioritySupport         Boolean @default(false) @map("has_priority_support")
  showBranding               Boolean @default(true) @map("show_branding") // Free = true
  showUpgradeBanner          Boolean @default(true) @map("show_upgrade_banner") // Free = true

  // FAQ bot — réponses configurables par le vendeur (Phase 5.3)
  faqDelivery     String? @map("faq_delivery") @db.Text
  faqPayment      String? @map("faq_payment") @db.Text
  faqLocation     String? @map("faq_location") @db.Text
  faqAvailability String? @map("faq_availability") @db.Text

  // WhatsApp Business — catalogue Meta Commerce Manager
  metaCatalogId      String? @map("meta_catalog_id")
  hasMetaCatalogSync Boolean @default(false) @map("has_meta_catalog_sync") // Entitlement Starter/Pro

  // WhatsApp Business — selected approved message template for tenant workflows
  whatsappTemplateName     String? @map("whatsapp_template_name")
  whatsappTemplateLanguage String? @map("whatsapp_template_language")
  whatsappTemplateCategory String? @map("whatsapp_template_category")

  // Away message — réponse automatique hors horaires d'ouverture
  businessHoursStart String? @map("business_hours_start") // ex: "08:00"
  businessHoursEnd   String? @map("business_hours_end") // ex: "20:00"
  businessTimezone   String? @map("business_timezone") // ex: "Africa/Abidjan"
  awayMessage        String? @map("away_message") @db.Text

  users                User[]
  conversationStates   ConversationState[]
  categoryPrices       CategoryPrice[]
  deliveryZones        DeliveryZone[]
  deliveryFeeCommune   DeliveryFeeCommune[]
  invitations          Invitation[]
  messagesIn           MessageIn[]
  messagesOut          MessageOut[]
  sellerPhones         SellerPhone[]
  eventLogs            EventLog[]
  deadLetterJobs       DeadLetterJob[]
  optOuts              OptOut[]
  liveSessions         LiveSession[]
  liveItems            LiveItem[]
  catalogueItems       CatalogueItem[]
  conversationWindows  ConversationWindow[]
  reservations         Reservation[]
  waitlists            Waitlist[]
  orders               Order[]
  paymentProofs        PaymentProof[]
  subscriptionPayments SubscriptionPayment[]
  itemVariants         ItemVariant[]

  @@map("tenants")
}

// Invitation envoyée par un Owner/Manager pour ajouter un agent au tenant (story 1-7)
model Invitation {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String
  role       Role      @default(AGENT)
  tokenHash  String    @unique @map("token_hash") // Hash SHA-256 du token
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tokenHash])
  // Note: Contrainte unique partielle (tenantId, email) où consumedAt IS NULL
  // sera créée via migration SQL car Prisma ne supporte pas directement les contraintes partielles
  @@map("invitations")
}

// Zone regroupant plusieurs communes (ex. Abidjan, Intérieur du pays)
model DeliveryZone {
  id        String                @id @default(cuid())
  tenantId  String                @map("tenant_id")
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // ex. "Abidjan", "Intérieur du pays"
  amount    Int                   @map("amount_cents")
  communes  DeliveryZoneCommune[]
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("delivery_zones")
}

// Communes appartenant à une zone (identifiées par nom, pas de code en Côte d'Ivoire)
model DeliveryZoneCommune {
  id          String       @id @default(cuid())
  zoneId      String       @map("zone_id")
  zone        DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  communeName String       @map("commune_name") // ex. "Cocody", "Marcory", "Yopougon"

  @@unique([zoneId, communeName])
  @@index([zoneId])
  @@map("delivery_zone_communes")
}

// Prix par commune (hors zone ou surcharge), identifié par nom
model DeliveryFeeCommune {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  communeName String   @map("commune_name") // ex. "Cocody", "Bouaké"
  amount      Int      @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, communeName])
  @@index([tenantId])
  @@map("delivery_fee_communes")
}

model User {
  id            String    @id @default(cuid())
  tenantId      String?   @map("tenant_id") // Nullable : null pour les users OPS (pas de tenant)
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  passwordHash  String?   @map("password_hash")
  role          Role      @default(OWNER)
  tokenVersion  Int       @default(0) @map("token_version") // Révocation JWT : incrémenter pour invalider toutes les sessions actives
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  accounts      Account[]
  sessions      Session[]

  @@index([tenantId])
  @@map("users")
}

// NextAuth / Auth.js Prisma adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model CategoryPrice {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryLetter String   @map("category_letter") // code libre (ex. A, AB, Premium)
  amount         Int      @map("amount_cents")
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, categoryLetter])
  @@index([tenantId])
  @@map("category_prices")
}

// Message entrant WhatsApp (webhook) - Story 2.1
model MessageIn {
  id                String   @id @default(cuid())
  tenantId          String?  @map("tenant_id") // nullable si tenant non résolu
  tenant            Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  providerMessageId String   @map("provider_message_id") // ex. wamid Meta
  from              String // numéro WhatsApp expéditeur
  body              String   @db.Text
  mediaUrl          String?  @map("media_url")
  correlationId     String   @map("correlation_id") // UUID ou message_sid pour traçabilité
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, providerMessageId])
  @@index([tenantId])
  @@map("messages_in")
}

// Numéro de téléphone vendeur par tenant (Story 2.2)
// Permet de distinguer les messages vendeur des messages client
model SellerPhone {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumber String   @map("phone_number") // Format E.164 normalisé (ex. +33612345678)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tenantId, phoneNumber])
  @@index([tenantId])
  @@map("seller_phones")
}

// Event Log pour traçabilité des événements critiques (Story 2.3)
// Architecture §9: Event Log avec correlationId pour diagnostic bout en bout
// Architecture §426-430: event_type verbe/nom explicite, correlation_id propagé, payload JSON structuré sans PII
model EventLog {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id") // NOT NULL: isolation tenant stricte
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType     String   @map("event_type") // webhook_received, message_sent, idempotent_ignored
  entityType    String   @map("entity_type") // message_in, message_out, etc.
  entityId      String?  @map("entity_id") // ID de l'entité concernée (nullable si pas d'entité)
  correlationId String   @map("correlation_id") // UUID ou message_sid pour traçabilité bout en bout
  actorType     String   @map("actor_type") // system, seller, client
  payload       Json // JSON structuré, pas de PII (Architecture §430)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, correlationId]) // Lookup rapide par flux
  @@index([tenantId, eventType, createdAt]) // Filtrage par type et date
  @@index([tenantId])
  @@map("event_log")
}

// Opt-out STOP par tenant (Story 2.5) - scope tenant, isolation stricte
model OptOut {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id") // NOT NULL: isolation tenant stricte
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumber String   @map("phone_number") // Format E.164 normalisé
  optedOutAt  DateTime @default(now()) @map("opted_out_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, phoneNumber]) // index unique implicite pour lookup rapide
  @@map("opt_outs")
}

// Message sortant via outbox (Story 2.4)
// Architecture §4.5: Outbound messaging via outbox + retries + DLQ
// Tout envoi sortant écrit d'abord dans MessageOut (outbox) avec statut pending

// Session live par tenant - création/fermeture auto (Story 2.6)
// Une seule session active par tenant à la fois (contrainte applicative)
enum LiveSessionStatus {
  active
  closed
}

model LiveSession {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id")
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status         LiveSessionStatus @default(active)
  lastActivityAt DateTime          @map("last_activity_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  liveItems      LiveItem[]
  reservations   Reservation[]

  @@index([tenantId, status])
  @@map("live_sessions")
}

// Item live par session — unicité (tenant_id, live_session_id, code) (Story 3.2)
// Story 3.4: availableQty / reservedQty pour stock préparé ; mediaStorageKey pour photo optionnelle
model LiveItem {
  id              String      @id @default(cuid())
  tenantId        String      @map("tenant_id")
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  liveSessionId   String      @map("live_session_id")
  liveSession     LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  code            String // normalisé trim + uppercase
  amount          Int?        @map("amount_cents") // optionnel, dérivé grille (Story 3.1)
  quantity        Int         @default(1) // total (availableQty + reservedQty) pour affichage
  availableQty    Int         @default(0) @map("available_qty") // stock préparé (Story 3.4)
  reservedQty     Int         @default(0) @map("reserved_qty") // réservé, décrément à confirmation (Story 3.6)
  mediaStorageKey String?     @map("media_storage_key") // clé R2 pour photo optionnelle (Story 3.4)
  attributes      Json? // Noms des dimensions (ex: ["Taille", "Couleur"])
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  reservations Reservation[]
  variants     ItemVariant[]

  @@unique([tenantId, liveSessionId, code])
  @@index([tenantId])
  @@index([liveSessionId])
  @@map("live_items")
}

// Story 8.1: Article catalogue persistant — seule source d'articles commandables
// Unicité (tenantId, code) — le code = étiquette persistante de l'article
model CatalogueItem {
  id              String              @id @default(cuid())
  tenantId        String              @map("tenant_id")
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code            String // normalisé trim + uppercase
  name            String? // Nom lisible (requis pour synchro Meta)
  amount          Int?                @map("amount_cents")
  quantity        Int                 @default(1)
  availableQty    Int                 @default(1) @map("available_qty")
  reservedQty     Int                 @default(0) @map("reserved_qty")
  mediaStorageKey String?             @map("media_storage_key")
  attributes      Json? // Noms des dimensions (ex: ["Taille", "Couleur"])
  origin          CatalogueItemOrigin @default(dashboard)
  createdInLive   Boolean             @default(false) @map("created_in_live")
  // Synchro WhatsApp Business catalogue Meta
  metaProductId   String?             @map("meta_product_id") // ID retourné par Meta après synchro
  syncedToMeta    Boolean             @default(false) @map("synced_to_meta")
  metaSyncedAt    DateTime?           @map("meta_synced_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  reservations Reservation[]
  waitlist     Waitlist[]
  variants     ItemVariant[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("catalogue_items")
}

enum CatalogueItemOrigin {
  live
  seller_whatsapp
  dashboard
}

model ItemVariant {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogueItemId String?        @map("catalogue_item_id")
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)
  liveItemId      String?        @map("live_item_id")
  liveItem        LiveItem?      @relation(fields: [liveItemId], references: [id], onDelete: Cascade)

  // Label combiné pour affichage (ex: "Rouge / XL")
  label String

  // Valeurs structurées (ex: {"Couleur": "Rouge", "Taille": "XL"})
  values Json

  quantity     Int @default(0)
  availableQty Int @default(0) @map("available_qty")
  reservedQty  Int @default(0) @map("reserved_qty")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reservations Reservation[]

  @@index([tenantId])
  @@index([catalogueItemId])
  @@index([liveItemId])
  @@map("item_variants")
}

// Réservation client par article (Story 4.1)
// Story 8.1: idempotence via partial unique indexes (migration SQL)
enum ReservationStatus {
  reserved
  address_collected
  confirmed
  expired
}

model Reservation {
  id              String            @id @default(cuid())
  tenantId        String            @map("tenant_id")
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  liveSessionId   String?           @map("live_session_id")
  liveSession     LiveSession?      @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  liveItemId      String?           @map("live_item_id")
  liveItem        LiveItem?         @relation(fields: [liveItemId], references: [id], onDelete: Cascade)
  catalogueItemId String?           @map("catalogue_item_id")
  catalogueItem   CatalogueItem?    @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)
  clientPhone     String            @map("client_phone") // E.164 normalisé
  quantity        Int               @default(1)
  variantId       String?           @map("variant_id")
  variant         ItemVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  status          ReservationStatus @default(reserved)
  address         String?           @db.Text
  addressCity     String?           @map("address_city")
  addressCommune  String?           @map("address_commune")
  addressZone     String?           @map("address_zone")
  addressDetails  String?           @map("address_details") // Indications supplémentaires
  addressRaw      String?           @map("address_raw") // Texte original pour compatibilité
  expiresAt       DateTime?         @map("expires_at")
  reminderSentAt  DateTime?         @map("reminder_sent_at") // Story 4.4: rappel T-2 min envoyé une seule fois
  correlationId   String            @map("correlation_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  order           Order?

  // Note: partial unique indexes are defined in the migration SQL (Prisma doesn't support partial indexes)
  @@index([tenantId, liveSessionId, clientPhone])
  @@index([tenantId])
  @@index([liveItemId, liveSessionId])
  @@index([catalogueItemId])
  @@map("reservations")
}

// État de conversation par client (Phase 5.1) — handoff + contexte bot
model ConversationState {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String
  handedOff Boolean  @default(false) @map("handed_off")
  state     String? // 'choosing_variant', 'collected_address', etc.
  metadata  Json? // { catalogueItemId: '...', quantity: 3, attributes: { "Couleur": "Bleu" } }
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("conversation_states")
}

// Session de conversation 24h (Story Credits) — 1 credit = 1 fenêtre client
model ConversationWindow {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerPhone String   @map("customer_phone")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, customerPhone])
  @@index([tenantId, expiresAt])
  @@map("conversation_windows")
}

// Commande créée à la confirmation (OUI) — Story 4.5
enum OrderStatus {
  confirmed
  confirmed_pending_deposit
  preparing // prépa (Story 6.3)
  in_delivery // livraison (Story 6.3)
  delivered
  cancelled
}

enum DepositStatus {
  no_deposit
  deposit_pending
  deposit_approved
  deposit_rejected
}

model Order {
  id               String         @id @default(cuid())
  tenantId         String         @map("tenant_id")
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservationId    String         @unique @map("reservation_id")
  reservation      Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  orderNumber      String         @map("order_number") // SS-XXXX (SnapSell)
  status           OrderStatus
  depositStatus    DepositStatus  @map("deposit_status")
  depositExpiresAt DateTime?      @map("deposit_expires_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  paymentProofs    PaymentProof[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([reservationId])
  @@map("orders")
}

// Story 5.3: Preuve d'acompte (image ou texte) liée à une commande
enum PaymentProofStatus {
  pending
  approved
  rejected
}

model PaymentProof {
  id              String             @id @default(cuid())
  orderId         String             @map("order_id")
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId        String             @map("tenant_id")
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mediaStorageKey String?            @map("media_storage_key") // clé R2 (signed URL dérivée)
  textPayload     String?            @map("text_payload") @db.Text // preuve texte
  status          PaymentProofStatus @default(pending)
  reviewedAt      DateTime?          @map("reviewed_at")
  correlationId   String             @map("correlation_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([orderId])
  @@index([tenantId, status])
  @@map("payment_proofs")
}

// File d'attente par article/session (Story 4.3, 9.1)
// position = ordre d'arrivée (max+1 sous lock)
// Story 9.1: catalogueItemId nullable, liveSessionId/liveItemId nullable
// Unicité via partial unique indexes en SQL (Prisma ne supporte pas les index partiels)
model Waitlist {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  liveSessionId   String?        @map("live_session_id")
  liveItemId      String?        @map("live_item_id")
  catalogueItemId String?        @map("catalogue_item_id")
  catalogueItem   CatalogueItem? @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)
  clientPhone     String         @map("client_phone")
  position        Int // ordre d'arrivée
  correlationId   String         @map("correlation_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([tenantId, liveSessionId, liveItemId])
  @@index([liveItemId, liveSessionId])
  @@index([catalogueItemId])
  @@map("waitlist")
}

// Dead Letter Queue pour messages échoués après N retries (Story 2.4)
// Architecture §4.5: DLQ après échec répété pour traçabilité ops
model DeadLetterJob {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id") // NOT NULL: isolation tenant stricte
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobType      String    @map("job_type") // ex. 'message_out'
  payload      Json // Payload original (JSON)
  errorMessage String?   @map("error_message") @db.Text
  errorStack   String?   @map("error_stack") @db.Text
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at") // null si non résolu

  @@index([tenantId, jobType, resolvedAt]) // Filtrage ops
  @@index([tenantId])
  @@map("dead_letter_jobs")
}

model MessageOut {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id") // NOT NULL: isolation tenant stricte
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  to                 String // destinataire (format E.164 normalisé)
  body               String?   @db.Text
  mediaUrl           String?   @map("media_url") @db.Text // Story 9.4: URL média (photo article) pour MMS WhatsApp
  interactivePayload Json?     @map("interactive_payload") // Payload boutons/liste pour messages interactifs WhatsApp
  isTypingIndicator  Boolean   @default(false) @map("is_typing_indicator") // Story 11.2
  status             String // pending | sending | sent | failed | blocked (STOP)
  attempts           Int       @default(0)
  nextAttemptAt      DateTime? @map("next_attempt_at")
  lastError          String?   @map("last_error") @db.Text
  correlationId      String    @map("correlation_id") // UUID ou message_sid pour traçabilité
  providerMessageId  String?   @map("provider_message_id") // wamid Meta après envoi réussi
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, correlationId, to]) // Anti-doublon : même message pas écrit deux fois (optionnel Story 2.4)
  @@index([tenantId, status]) // Lookup rapide des messages pending
  @@index([tenantId, correlationId]) // Traçabilité par correlationId
  @@index([tenantId])
  @@map("messages_out")
}

// Story 7A.2: Historique paiements abonnement + overages
model SubscriptionPayment {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paystackReference String   @unique @map("paystack_reference") // Idempotence
  type              String // "subscription" | "overage"
  plan              String? // "starter" | "pro" (null si overage seul)
  amount            Int // Montant en FCFA
  currency          String   @default("XOF")
  status            String // "pending" | "success" | "failed"
  channel           String? // "card" | "mobile_money"
  cardLast4         String?  @map("card_last4")
  overageDetails    Json?    @map("overage_details")
  // { ordersOverQuota: 12, ratePerOrder: 75, totalAmount: 900 }
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, type, status])
  @@map("subscription_payments")
}
